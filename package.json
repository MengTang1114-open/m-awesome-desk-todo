{
  "name": "m-awesome-desk-todo",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "description": "Mac 桌宠 + 待办：四只宠物分别管 To-do / Pending / Completed / Archived，数据是一份 Markdown，AI 也能直接改",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "vite build && electron .",
    "app": "vite build && electron-builder --mac --dir",
    "dist": "vite build && electron-builder --mac",
    "test": "node --test tests/*.test.mjs",
    "dist:signed": "vite build && electron-builder --mac -c.mac.notarize=true"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  },
  "build": {
    "appId": "io.github.mengtang1114.awesome-desk-todo",
    "productName": "Awesome Desk Todo",
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg"
      ],
      "extendInfo": {
        "LSUIElement": true
      },
      "hardenedRuntime": true
    },
    "directories": {
      "output": "release"
    }
  }
}
